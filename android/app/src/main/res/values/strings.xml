    <string name="metered_wait">Wait for Wi-Fi</string>
    <string name="metered_now">Download now</string>

    <string name="mic_step_title">Allow the microphone</string>
    <string name="mic_step_body">Wisperlow only listens while the bubble is purple, after you tap it. Audio is processed on your phone and thrown away.</string>
    <string name="mic_step_notifications">We’ll also ask to show a quiet notification. Android requires it while the bubble is on, and it gives you a one-tap “Turn off”.</string>
    <string name="mic_step_denied">Permission was denied. Open app settings, tap Permissions, then allow Microphone.</string>
    <string name="mic_step_open_app_settings">Open app settings</string>

    <string name="overlay_step_title">Let the bubble float over apps</string>
    <string name="overlay_step_body">Android calls this “Display over other apps”. It lets the bubble sit next to your keyboard in any app.</string>
    <string name="overlay_step_1">Tap <b>Open settings</b> below.</string>
    <string name="overlay_step_2">Find <b>Wisperlow</b> in the list (if a list appears).</string>
    <string name="overlay_step_3">Turn on <b>Allow display over other apps</b>.</string>
    <string name="overlay_step_4">Press Back to return here.</string>

    <string name="a11y_step_title">Let Wisperlow type for you</string>
    <string name="a11y_step_body">Turning on the Wisperlow Accessibility service lets it put text straight into the field you’re typing in, and show the bubble only while your keyboard is open.</string>
    <string name="a11y_step_privacy">Android will warn that the service can see your screen. Wisperlow only looks for the text field you’re in, has no internet access for your data, and never records anything unless you tap the bubble.</string>
    <string name="a11y_step_1">Tap <b>Open settings</b> below.</string>
    <string name="a11y_step_2">Tap <b>Installed apps</b> or <b>Downloaded apps</b> (the name varies by phone).</string>
    <string name="a11y_step_3">Tap <b>Wisperlow Dictation</b>.</string>
    <string name="a11y_step_4">Turn it <b>on</b>, then tap <b>Allow</b>.</string>
    <string name="a11y_restricted_title">Switch greyed out, or “Restricted setting”?</string>
    <string name="a11y_restricted_body">Android blocks this for apps installed outside the Play Store until you allow it:\n1. Tap <b>Open App info</b> below.\n2. Tap the <b>⋮</b> menu in the top corner.\n3. Tap <b>Allow restricted settings</b> and confirm.\n4. Come back and tap <b>Open settings</b> again.</string>
    <string name="a11y_open_app_info">Open App info</string>
    <string name="a11y_skip_note">Without it, Wisperlow copies your words so you can paste them yourself.</string>

    <string name="try_step_title">Try it here</string>
    <string name="try_step_body">Tap the microphone and say something like “Hey Sam, I’m running ten minutes late, see you soon.” Then pause.</string>
    <string name="try_field_label">Your words appear here</string>
    <string name="try_start">Tap to talk</string>
    <string name="try_listening">Listening… pause when done</string>
    <string name="try_loading">Listening… (getting ready)</string>
    <string name="try_finishing">Writing it down…</string>
    <string name="try_needs_model">The speech model is still downloading. Try again when it’s ready.</string>
    <string name="try_clear">Clear</string>

    <string name="done_title">You’re all set</string>
    <string name="done_body">Open any app, tap a text field, then tap the bubble. A few handy moves:</string>
    <string name="tip_tap">Tap the bubble to start. Tap again to finish early.</string>
    <string name="tip_pause">Just pause when you’re done. It types automatically.</string>
    <string name="tip_hold">Hold the bubble to cancel what you said.</string>
    <string name="tip_drag">Drag the bubble to move it. Drop it on the ✕ to hide it.</string>
    <string name="tip_words">Add names and jargon in <b>Words</b> so they’re always spelled right.</string>
    <string name="tip_restart">After restarting your phone, tap the Wisperlow notification to bring the bubble back.</string>
    <string name="done_start">Turn on the bubble</string>
    <string name="done_missing">Some steps are unfinished. The bubble will work once they’re done.</string>

