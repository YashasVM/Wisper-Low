    <!-- Onboarding -->
    <string name="onboarding_step">Step %1$d of %2$d</string>
    <string name="welcome_title">Talk instead of type, in any app</string>
    <string name="welcome_body">Wisperlow puts a small microphone bubble next to your keyboard. Tap it, speak, and your words are typed for you.</string>
    <string name="welcome_point_private">Everything runs on your phone. Your voice never leaves it.</string>
    <string name="welcome_start">Let’s set it up</string>

    <string name="how_title">How it works</string>
    <string name="how_body">Three steps, every time:</string>
    <string name="how_step1_title">Tap any text field</string>
    <string name="how_step1_body">When your keyboard opens, the Wisperlow bubble appears at the edge of the screen.</string>
    <string name="how_step2_title">Tap the bubble and speak</string>
    <string name="how_step2_body">It turns purple while it listens. Your words appear in it as you talk.</string>
    <string name="how_step3_title">Pause, and it types for you</string>
    <string name="how_step3_body">After a short pause, the text goes straight into the field. Tap the bubble to finish sooner.</string>

    <string name="model_step_title">Download the speech model</string>
    <string name="model_step_body">This is the brain that turns speech into text. It is downloaded once and then works offline.</string>
    <string name="model_step_background">You can continue while it downloads.</string>
    <string name="model_recommended">Recommended</string>
    <string name="model_kind_multilingual">Most accurate. English and 24 European languages. Needs about 1 GB of free memory.</string>
    <string name="model_kind_english">Very accurate, English only. Needs about 1 GB of free memory.</string>
    <string name="model_kind_fast">Fast and light, English only. Best for older phones.</string>
    <string name="model_size_mb">%1$d MB</string>
    <string name="model_download">Download</string>
    <string name="model_use">Use this</string>
    <string name="model_in_use">In use</string>
