    <string name="keyboard_step_title">Turn on the Wisperlow keyboard</string>
    <string name="keyboard_step_body">Wisperlow types through Android’s keyboard system, so it needs no special access to your screen.</string>
    <string name="keyboard_step_1">Tap <b>Open settings</b> below.</string>
    <string name="keyboard_step_2">Tap <b>On-screen keyboard</b> or <b>Manage keyboards</b> if you see it (the name varies by phone).</string>
    <string name="keyboard_step_3">Turn on <b>Wisperlow</b>.</string>
    <string name="keyboard_step_4">Press Back to return here.</string>
    <string name="keyboard_step_privacy">Android shows a standard warning that any keyboard can collect what you type. Wisperlow has no network access for your text: your voice, typing and learned words never leave your phone.</string>
    <string name="keyboard_step_pick">Choose keyboard</string>
    <string name="switch_step_title">Switching keyboards</string>
    <string name="switch_step_body">Wisperlow is a full keyboard with autocorrect, suggestions and emoji, and a mic built into the top bar. Make it your default, or switch to it with the keyboard button at the bottom of the screen.</string>
    <string name="switch_step_note">Long-press the space bar on Wisperlow to switch keyboards at any time. Try it now with Choose keyboard, or skip.</string>
    <string name="tip_switch">Long-press the space bar to switch keyboards. Drag along it to move the cursor.</string>
