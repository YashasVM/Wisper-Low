    <string name="mic_step_title">Allow the microphone</string>
    <string name="mic_step_body">Wisperlow only listens while the mic on its keyboard is purple, after you tap it. Audio is processed on your phone and thrown away.</string>
    <string name="mic_step_denied">Permission was denied. Open app settings, tap Permissions, then allow Microphone.</string>
    <string name="mic_step_open_app_settings">Open app settings</string>



    <string name="try_step_title">Try it here</string>
    <string name="try_step_body">Tap the microphone and say something like “Hey Sam, I’m running ten minutes late, see you soon.” Then pause.</string>
    <string name="try_field_label">Your words appear here</string>
    <string name="try_start">Tap to talk</string>
    <string name="try_listening">Listening… pause when done</string>
    <string name="try_loading">Listening… (getting ready)</string>
    <string name="try_finishing">Writing it down…</string>
    <string name="try_needs_model">The speech model is still downloading. Try again when it’s ready.</string>
    <string name="try_clear">Clear</string>

    <string name="done_title">You’re all set</string>
    <string name="done_body">Open any app, tap a text field, switch to the Wisperlow keyboard, then tap the mic. A few handy moves:</string>
    <string name="tip_tap">Tap the mic to start. Tap again to finish early.</string>
    <string name="tip_pause">Just pause when you’re done. It types automatically.</string>
    <string name="tip_hold">Hold the mic to cancel what you said.</string>
    <string name="tip_words">Add names and jargon in <b>Words</b> so they’re always spelled right.</string>
    <string name="done_start">Start using Wisperlow</string>
    <string name="done_missing">Some steps are unfinished. The keyboard will work once they’re done.</string>

